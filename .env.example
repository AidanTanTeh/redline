# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Google AI Studio key (free tier). Used for the Gemini target/judge.
# OpenAI-compatible base URL: https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=

# Local Ollama server (OpenAI-compatible endpoint). No key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1
